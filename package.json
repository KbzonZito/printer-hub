{
  "name": "printer-hub",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "apk": "scripts/build-apk.sh",
    "release": "scripts/release.sh",
    "mock": "node scripts/mock-moonraker.mjs",
    "test": "vitest run",
    "bench:gcode": "GCODE_BENCH=1 vitest run src/gcode/parser.perf.test.ts",
    "lint": "oxlint",
    "format": "prettier --write src scripts e2e playwright.config.ts",
    "format:check": "prettier --check src scripts e2e playwright.config.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "tsc --noEmit && npm run lint && npm run format:check && npm run check:i18n && npm test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@material/material-color-utilities": "^0.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "license": "MIT"
}
